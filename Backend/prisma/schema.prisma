generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  password             String?
  role                 UserRole  @default(PATIENT)
  isActive             Boolean   @default(true)
  isEmailVerified      Boolean   @default(false)
  googleId             String?   @unique
  profileImage         String?
  lastLogin            DateTime?
  profileImagePublicId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  adminProfile   AdminProfile?
  sessions       Session[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model PatientProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  name        String
  phone       String?
  dateOfBirth DateTime?
  gender      Gender?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  payments         Payment[]
  medicalHistories MedicalHistory[]
  medicalReports   MedicalReport[]

  @@map("patient_profiles")
}

model DoctorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String
  phone           String?
  departmentId    String?
  specialization  String?
  qualification   String?
  experience      Int?
  consultationFee Float?
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  payments     Payment[]
  schedules    DoctorSchedule[]

  @@map("doctor_profiles")
}

model DoctorSchedule {
  id        String   @id @default(cuid())
  doctorId  String
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
  @@map("doctor_schedules")
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  phone       String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors DoctorProfile[]

  @@map("departments")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Appointment {
  id               String            @id @default(cuid())
  patientId        String
  doctorId         String
  appointmentAt    DateTime
  problem          String?
  patientDeletedAt DateTime?
  status           AppointmentStatus @default(PENDING)
  doctorArchived   Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payment          Payment?

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  prescription Prescription?

  sharedMedicalHistories AppointmentMedicalHistory[]
  sharedMedicalReports   AppointmentMedicalReport[]

  @@unique([doctorId, appointmentAt])
  @@map("appointments")
}

model Prescription {
  id            String    @id @default(cuid())
  appointmentId String    @unique
  diagnosis     String
  advice        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  followUpDate  DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  medicines PrescriptionMedicine[]
  tests     PrescriptionTest[]

  @@map("prescriptions")
}

model PrescriptionMedicine {
  id             String  @id @default(cuid())
  prescriptionId String
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_medicines")
}

model PrescriptionTest {
  id             String @id @default(cuid())
  prescriptionId String
  testName       String

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_tests")
}

model Payment {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  patientId     String
  doctorId      String
  amount        Float
  currency      String        @default("BDT")
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

model MedicalHistory {
  id          String    @id @default(cuid())
  patientId   String
  condition   String
  details     String?
  diagnosedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  sharedAppointments AppointmentMedicalHistory[]

  @@index([patientId])
  @@map("medical_histories")
}

model MedicalReport {
  id           String   @id @default(cuid())
  patientId    String
  title        String
  description  String?
  fileUrl      String
  filePublicId String?
  fileType     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  sharedAppointments AppointmentMedicalReport[]

  @@index([patientId])
  @@map("medical_reports")
}

model AppointmentMedicalHistory {
  id               String @id @default(cuid())
  appointmentId    String
  medicalHistoryId String

  appointment    Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  medicalHistory MedicalHistory @relation(fields: [medicalHistoryId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, medicalHistoryId])
  @@index([appointmentId])
  @@index([medicalHistoryId])
  @@map("appointment_medical_histories")
}

model AppointmentMedicalReport {
  id              String @id @default(cuid())
  appointmentId   String
  medicalReportId String

  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  medicalReport MedicalReport @relation(fields: [medicalReportId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, medicalReportId])
  @@index([appointmentId])
  @@index([medicalReportId])
  @@map("appointment_medical_reports")
}
